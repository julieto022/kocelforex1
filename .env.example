# Kocel Forex Hub — environment reference
#
# Values are provisioned automatically by Lovable Cloud. This file documents
# what the app expects; it never contains real secrets.

# ---- Browser (safe to expose) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---- Server only (never exposed to the browser) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# HMAC key used to sign Kocel Bridge session tokens.
BRIDGE_TOKEN_SECRET=change-me-64-random-chars

# Public origin used in authorization URLs returned to the Bridge EA.
PUBLIC_APP_URL=https://your-project.lovable.app

# Pepper mixed into opaque authorization poll-token and session hashes before storage.
CONNECTION_CODE_PEPPER=change-me-64-random-chars

# Shared secret for scheduled jobs hitting /api/public/* endpoints.
LOVABLE_CRON_SECRET=change-me
